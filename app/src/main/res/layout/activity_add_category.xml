<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add new a Category"
        android:layout_gravity="center_horizontal"
        android:textSize="22sp"
        android:textStyle="bold"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#B1E3EB"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:hint="Enter Name's Category"
        android:inputType="text"
        android:autofillHints="false"
        android:id="@+id/edtCategoryName"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#B1E3EB"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:hint="Enter Description"
        android:inputType="text"
        android:autofillHints="false"
        android:id="@+id/edtCategoryDescription"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#03A9F4"
        android:text="Save"
        android:textColor="@color/white"
        android:id="@+id/btnSaveNewCategory"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#00BCD4"
        android:text="Back"
        android:textColor="@color/white"
        android:id="@+id/btnBackNewCategory"/>
</LinearLayout>